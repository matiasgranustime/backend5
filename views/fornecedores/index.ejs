
<%- include('../partials/header') %>

<h2 class="mb-3">Fornecedores</h2>

<div class="d-flex justify-content-between mb-3">

    <form action="/fornecedores" method="GET" class="d-flex">
        <input
            type="text"
            name="busca"
            class="form-control me-2"
            placeholder="Pesquisar fornecedor..."
            value="<%= busca %>"
        >

        <button type="submit" class="btn btn-primary">
            Buscar
        </button>
    </form>

    <a href="/fornecedores/novo" class="btn btn-success">
        Novo Fornecedor
    </a>

</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>CNPJ</th>
            <th>Telefone</th>
            <th>E-mail</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        <% fornecedores.forEach(fornecedor => { %>
            <tr>
                <td><%= fornecedor.nome %></td>
                <td><%= fornecedor.cnpj || '-' %></td>
                <td><%= fornecedor.telefone || '-' %></td>
                <td><%= fornecedor.email || '-' %></td>
                <td><%= fornecedor.status %></td>
                <td>
                    <a href="/fornecedores/<%= fornecedor._id %>/editar"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <form action="/fornecedores/<%= fornecedor._id %>?_method=DELETE"
                          method="POST"
                          class="d-inline"
                          onsubmit="return confirm('Deseja excluir este fornecedor?')">

                        <button type="submit" class="btn btn-danger btn-sm">
                            Excluir
                        </button>
                    </form>
                </td>
            </tr>
        <% }) %>

        <% if (fornecedores.length === 0) { %>
            <tr>
                <td colspan="6" class="text-center">
                    Nenhum fornecedor cadastrado.
                </td>
            </tr>
        <% } %>
    </tbody>
</table>

<%- include('../partials/footer') %>
