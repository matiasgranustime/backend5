
<%- include('../partials/header') %>

<h2 class="mb-3">Produtos</h2>

<div class="d-flex justify-content-between mb-3">
    <form action="/produtos" method="GET" class="d-flex">
        <input
            type="text"
            name="busca"
            class="form-control me-2"
            placeholder="Pesquisar produto..."
            value="<%= busca %>"
        >
        <button type="submit" class="btn btn-primary">
            Buscar
        </button>
    </form>

    <a href="/produtos/novo" class="btn btn-success">
        Novo Produto
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Quantidade</th>
                <th>Preço de venda</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            <% produtos.forEach(produto => { %>
                <tr>
                    <td><%= produto.codigo %></td>
                    <td><%= produto.nome %></td>
                    <td><%= produto.categoria || '-' %></td>
                    <td><%= produto.quantidade %></td>
                    <td>R$ <%= Number(produto.precoVenda).toFixed(2) %></td>
                    <td>
                        <a href="/produtos/<%= produto._id %>/editar"
                           class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <form action="/produtos/<%= produto._id %>?_method=DELETE"
                              method="POST"
                              class="d-inline"
                              onsubmit="return confirm('Deseja excluir este produto?')">

                            <button type="submit" class="btn btn-danger btn-sm">
                                Excluir
                            </button>
                        </form>
                    </td>
                </tr>
            <% }) %>

            <% if (produtos.length === 0) { %>
                <tr>
                    <td colspan="6" class="text-center">
                        Nenhum produto cadastrado.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('../partials/footer') %>
