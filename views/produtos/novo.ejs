
<%- include('../partials/header') %>

<h2 class="mb-3">Cadastrar Produto</h2>

<form action="/produtos" method="POST">

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Código</label>
            <input type="text" name="codigo" class="form-control" required>
        </div>

        <div class="col-md-8 mb-3">
            <label class="form-label">Nome do produto</label>
            <input type="text" name="nome" class="form-control" required>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Categoria</label>
            <input type="text" name="categoria" class="form-control">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Fornecedor</label>
            <input type="text" name="fornecedor" class="form-control">
        </div>

        <div class="col-md-12 mb-3">
            <label class="form-label">Descrição</label>
            <textarea name="descricao" class="form-control"></textarea>
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Quantidade</label>
            <input type="number" name="quantidade" class="form-control" min="0" value="0" required>
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Estoque mínimo</label>
            <input type="number" name="estoqueMinimo" class="form-control" min="0" value="5">
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Unidade</label>
            <input type="text" name="unidade" class="form-control" value="Unidade">
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Preço de compra</label>
            <input type="number" name="precoCompra" class="form-control" min="0" step="0.01" required>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Preço de venda</label>
            <input type="number" name="precoVenda" class="form-control" min="0" step="0.01" required>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Salvar</button>
    <a href="/produtos" class="btn btn-secondary">Voltar</a>

</form>

<%- include('../partials/footer') %>
