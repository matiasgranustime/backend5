
<%- include('../partials/header') %>

<h2 class="mb-3">Categorias</h2>

<div class="d-flex justify-content-between mb-3">

    <form action="/categorias" method="GET" class="d-flex">
        <input
            type="text"
            name="busca"
            class="form-control me-2"
            placeholder="Pesquisar categoria..."
            value="<%= busca %>"
        >

        <button type="submit" class="btn btn-primary">
            Buscar
        </button>
    </form>

    <a href="/categorias/novo" class="btn btn-success">
        Nova Categoria
    </a>

</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        <% categorias.forEach(categoria => { %>
            <tr>
                <td><%= categoria.nome %></td>
                <td><%= categoria.descricao || '-' %></td>
                <td><%= categoria.status %></td>
                <td>
                    <a href="/categorias/<%= categoria._id %>/editar"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <form action="/categorias/<%= categoria._id %>?_method=DELETE"
                          method="POST"
                          class="d-inline"
                          onsubmit="return confirm('Deseja excluir esta categoria?')">

                        <button type="submit" class="btn btn-danger btn-sm">
                            Excluir
                        </button>
                    </form>
                </td>
            </tr>
        <% }) %>

        <% if (categorias.length === 0) { %>
            <tr>
                <td colspan="4" class="text-center">
                    Nenhuma categoria cadastrada.
                </td>
            </tr>
        <% } %>
    </tbody>
</table>

<%- include('../partials/footer') %>
